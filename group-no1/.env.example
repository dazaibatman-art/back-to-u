# ==============================================================================
# Group No1 — Environment Configuration Template
# Copy this file to .env and adjust variables for your local or production environment.
# ==============================================================================

# Application Environment (development, testing, production)
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# Secret Key for Session Cryptography and CSRF
# Generate in python with: import secrets; secrets.token_hex(32)
SECRET_KEY=dev-secret-key-group-no1-change-in-production

# Database Connection URL
# SQLite default: sqlite:///instance/lost_and_found.db
# PostgreSQL example: postgresql://username:password@localhost:5432/group_no1_db
DATABASE_URL=sqlite:///instance/lost_and_found.db

# File Storage Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Security Settings
SESSION_COOKIE_SECURE=False

# Rate Limiter Configuration
RATELIMIT_DEFAULT=200 per day; 60 per hour
RATELIMIT_STORAGE_URI=memory://
